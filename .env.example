# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://user-creds-loc.cognitiveservices.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure OpenAI Embedding Configuration
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_EMBEDDING_KEY=your-azure-embedding-key-here

# SEC EDGAR API Configuration
SEC_USER_AGENT=UserName email@example.com

# FinBERT Model
FINBERT_MODEL=ProsusAI/finbert
# Optional: LangSmith tracing of graph nodes, LLM calls and tool calls
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_PROJECT=finance-analyst

# Optional: Reddit discussions as a research channel (free app at reddit.com/prefs/apps)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Optional cross-encoder reranker (off when empty; eval showed it lowers MRR)
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
